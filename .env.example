DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.64,192.168.1.67,umusic.muzammilpeer.uk
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://192.168.1.64:8000,http://192.168.1.67:8000,https://umusic.muzammilpeer.uk
DATABASE_URL=postgresql://umusic:umusic@postgres:5432/umusic
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
UMUSIC_MEDIA_ROOT=/data/media
UMUSIC_QUARANTINE_ROOT=/data/quarantine
UMUSIC_STORAGE_BACKEND=local
UMUSIC_MAX_UPLOAD_BYTES=157286400
UMUSIC_SIGNED_URL_TTL_SECONDS=604800
UMUSIC_MAX_UPLOAD_FILES=100
UMUSIC_FFPROBE_PATH=ffprobe
UMUSIC_USE_INTERNAL_REDIRECT=false
UMUSIC_INTERNAL_MEDIA_PREFIX=/protected-media/
UMUSIC_FOLDER_IMPORT_ENABLED=true
UMUSIC_TASTE_IMPORT_ENABLED=true
UMUSIC_YOUTUBE_IMPORT_ENABLED=false
UMUSIC_IMPORT_ROOTS=/imports
UMUSIC_YTDLP_PATH=yt-dlp
UMUSIC_YOUTUBE_MAX_ITEMS=25
UMUSIC_REMOTE_IMPORT_ENABLED=true
UMUSIC_REMOTE_IMPORT_MAX_ITEMS=50
UMUSIC_BACKUP_PATH=./data/backups
