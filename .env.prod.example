DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=umusic.muzammilpeer.uk,192.168.1.67,192.168.1.64
DJANGO_CSRF_TRUSTED_ORIGINS=https://umusic.muzammilpeer.uk,https://192.168.1.67,https://192.168.1.64
POSTGRES_PASSWORD=replace-with-a-long-random-password
UMUSIC_API_RATE=600/min
UMUSIC_SIGNED_URL_TTL_SECONDS=604800
CLOUDFLARE_TUNNEL_TOKEN=store-the-remotely-managed-tunnel-token-only-on-the-server
# For local storage, use a durable host directory. For mounted/GFS storage,
# set this to the host mount point and set UMUSIC_STORAGE_BACKEND=mounted.
UMUSIC_STORAGE_BACKEND=local
UMUSIC_MEDIA_PATH=./data/media
UMUSIC_QUARANTINE_PATH=./data/quarantine
UMUSIC_BACKUP_PATH=./data/backups
UMUSIC_REMOTE_IMPORT_ENABLED=true
UMUSIC_REMOTE_IMPORT_MAX_ITEMS=50
# Enable only after accepting responsibility for authorized public sources.
UMUSIC_YOUTUBE_IMPORT_ENABLED=false
